# Google OAuth Credentials
# You can get these by creating an OAuth 2.0 Client ID in the Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Port for local OAuth callback server
AUTH_PORT=3000

# File paths for storage
TOKEN_STORAGE_PATH=tokens.json
IDEMPOTENCY_STORAGE_PATH=idempotency.json

# Logging
LOG_LEVEL=info

# Service Limits
MAX_RECIPIENTS=50
MAX_APPEND_SIZE=50000

# Required secret shared only with trusted server-side MCP clients (32+ characters)
MCP_ACCESS_TOKEN=
